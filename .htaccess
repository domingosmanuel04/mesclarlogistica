# Proxy requests to Next.js / PM2 server via PHP Socket Proxy
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass through existing static files directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all requests to index.php (Bulletproof Socket Proxy for Next.js / PM2)
  RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>
